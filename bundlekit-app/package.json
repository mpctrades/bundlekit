{
  "name": "bundlekit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "shopify app dev",
    "build": "react-router build",
    "build:widget": "esbuild extensions/bundlekit-widget/bundlekit.source.js --minify-whitespace --minify-syntax --target=es2018 --outfile=extensions/bundlekit-widget/assets/bundlekit.js --banner:js=\"/* generated by npm run build:widget from bundlekit.source.js */\"",
    "start": "react-router-serve ./build/server/index.js",
    "predeploy": "npm run build:widget",
    "deploy": "shopify app deploy",
    "config:link": "shopify app config link",
    "setup": "prisma generate && prisma migrate deploy",
    "prisma": "prisma",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@react-router/node": "^7.1.1",
    "@react-router/serve": "^7.1.1",
    "@shopify/app-bridge-react": "^4.1.6",
    "@shopify/polaris": "^13.9.0",
    "@shopify/polaris-icons": "^9.3.1",
    "@shopify/shopify-app-react-router": "^2.0.1",
    "@shopify/shopify-app-session-storage-prisma": "^10.0.1",
    "isbot": "^5.1.0",
    "motion": "^13.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.1.1"
  },
  "devDependencies": {
    "@react-router/dev": "^7.1.1",
    "@shopify/api-codegen-preset": "^1.1.1",
    "@shopify/cli": "^4.7.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.25.12",
    "prisma": "^6.19.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8"
  },
  "workspaces": [
    "extensions/*"
  ]
}
