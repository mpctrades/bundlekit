# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# `shopify app config link` and `shopify app dev` fill in SHOPIFY_API_KEY /
# SHOPIFY_API_SECRET / SHOPIFY_APP_URL for you during local development — you
# normally only need to set DATABASE_URL by hand.

# --- Database (required) ---------------------------------------------------
# Postgres is the schema default (prisma/schema.prisma). For a zero-setup
# local run, see the README's sqlite instructions instead.
DATABASE_URL="postgresql://bundlekit:bundlekit@localhost:5432/bundlekit_dev"

# --- Shopify app credentials -------------------------------------------------
# Filled in automatically by `shopify app config link` / `shopify app dev`.
# Set them by hand only for a production deploy (see docker-compose.yml).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Comma separated, must match [access_scopes] in shopify.app.toml.
SCOPES=read_products,write_products,write_discounts,read_orders
# The app's public URL, e.g. https://bundlekit.mpctrades.com
SHOPIFY_APP_URL=
# The app's handle as shown in the Partner Dashboard (Settings), used to
# build the Managed Pricing plan-selection URL. Not the same as the app name.
SHOPIFY_APP_HANDLE=bundlekit

# --- Optional ---------------------------------------------------------------
# Dev server port (vite.config.ts). Defaults to 3000.
PORT=3000

# --- Production / docker-compose.yml only -----------------------------------
# Password for the bundled Postgres container. Not read by the app itself.
POSTGRES_PASSWORD=
